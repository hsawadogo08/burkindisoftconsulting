# Configuration Apache / LiteSpeed pour l'hébergement mutualisé Hostinger.
#
# Ce fichier est copié tel quel dans la racine du site par le build (voir
# l'entrée d'asset dédiée dans angular.json : le glob `**/*` ignore les
# fichiers cachés, il faut donc nommer `.htaccess` explicitement).

# Pas de négociation de contenu : sinon une requête sur /images/hero-consultant
# servirait hero-consultant.webp de sa propre initiative.
Options -MultiViews

# Pas de listing de répertoire, et pas de listing possible non plus après le
# DirectorySlash Off ci-dessous.
Options -Indexes

DirectoryIndex index.html

# Indispensable : sans ça, mod_dir répond 301 vers /services/x/ sur toute URL
# correspondant à un répertoire réel, et entre en boucle avec la règle 1
# ci-dessous qui retire le slash final. Les pages prérendues étant servies
# explicitement par la règle 2, mod_dir n'a plus rien à ajouter.
DirectorySlash Off


# --- Routage ----------------------------------------------------------------
#
# L'ordre des règles est significatif : chacune s'appuie sur le fait que les
# précédentes n'ont pas abouti.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Une seule forme d'URL par page. Sans cette redirection, /services/x et
  #    /services/x/ seraient deux URL indexables pour un contenu identique.
  RewriteRule ^(.+)/$ /$1 [L,R=301]

  # 2. Page prérendue : servie directement. On la mappe explicitement sur son
  #    index.html plutôt que de laisser mod_dir rediriger vers l'URL à slash
  #    final — ça évite un aller-retour sur chaque page de service et de
  #    solution, et ça garde l'URL canonique de la règle 1.
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]

  # 3. Fichier réel (JS, CSS, images, polices) : servi tel quel. Cette règle
  #    est aussi ce qui empêche la règle 4 de boucler : au second passage sur
  #    /index.html, elle intercepte et arrête la réécriture.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 4. Tout le reste : la main au routeur Angular, qui a une route joker `**`.
  #    C'est ce qui évite un 404 Apache sur un accès direct à une URL de
  #    l'application.
  RewriteRule ^ /index.html [L]
</IfModule>


# --- Cache ------------------------------------------------------------------

<IfModule mod_headers.c>
  # JS et CSS à nom haché (outputHashing: "all") : un changement de contenu
  # change le nom du fichier. Immuables sans risque.
  <FilesMatch "-[A-Z0-9]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Polices auto-hébergées : les fichiers Lato ne changeront pas.
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Images : copiées depuis public/ SANS hachage. Un cache immuable d'un an
  # empêcherait le remplacement d'une image sous le même nom chez tous les
  # visiteurs déjà passés. 30 jours est le compromis.
  <FilesMatch "\.(png|jpe?g|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # HTML : systématiquement revalidé, sinon un déploiement reste invisible.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  <FilesMatch "\.(xml|txt)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>

  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header always unset X-Powered-By
</IfModule>


# --- Compression ------------------------------------------------------------

<IfModule mod_deflate.c>
  # `text/javascript` est indispensable : c'est le type que servent Apache et
  # LiteSpeed pour .js depuis la mise à jour de l'enregistrement IANA. Ne
  # déclarer que `application/javascript` laisse passer tout le JS en clair —
  # soit près de 600 ko non compressés sur ce site.
  #
  # woff2, webp, png et jpeg sont déjà compressés : les inclure coûterait du
  # CPU sans réduire la taille.
  AddOutputFilterByType DEFLATE text/html text/css text/plain \
    text/javascript application/javascript application/json \
    application/xml application/rss+xml image/svg+xml
</IfModule>


# --- Types MIME -------------------------------------------------------------

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
</IfModule>
